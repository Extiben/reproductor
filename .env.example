# Crea un archivo .env con estos valores, pero nunca lo subas a Git.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Tamaño máximo del caché local en megabytes.
KTO_CACHE_LIMIT_MB=2048

# Audius: la búsqueda y el streaming público funcionan sin credenciales.
# La API key (opcional) da más límite de solicitudes: https://api.audius.co/plans
# No pongas aquí el Bearer Token: esta es una app de escritorio (cliente).
AUDIUS_API_KEY=
AUDIUS_SEARCH_LIMIT=20
AUDIUS_TIMEOUT_SECONDS=10
